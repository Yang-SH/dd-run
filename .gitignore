# Rust 构建产物
/target/
Cargo.lock.orig

# 本地 AI 工作数据（会话记忆、技能等），不入库
/.workbuddy/

# 本地 AI 编码工具（ZCode）自动生成的忽略配置，非项目内容，不入库
/.zcodeignore

# 反馈用的临时截图（根目录），不入库
/image.png
/image-*.png

# 单文件分发生成物（tools/package.sh 产出），不入库
/dist/

# dd-gui 内嵌的扩展 exe（tools/package.sh 生成于 crates/dd-gui/assets/embed/，
# 由 build.rs include_bytes!；非源码、不提交，保留 .gitkeep 占位）
/crates/dd-gui/assets/embed/*.exe

# 文档体检工具（tools/docscan.py）的输出，随用随生成，不入库
/.docscan.txt
/.doclinks.txt


# B1：kittest 快照测试的比对衍生物（diff/new/old），仅比对失败时生成，不入库
crates/dd-gui/tests/snapshots/*.diff.png
crates/dd-gui/tests/snapshots/*.new.png
crates/dd-gui/tests/snapshots/*.old.png

# 清单 §2.2（2026-10-30）：cargo-fuzz 运行衍生物不入库——crash 工件 /
# 覆盖报告 / fuzz 构建树；语料种子（fuzz/corpus/）与 fuzz/Cargo.lock 入库
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/
